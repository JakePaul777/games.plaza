  COMMAND = cd /home/maxwe/Ghostship && chmod -R u+w Ghostship-3.0.0 Ghostship-3.0.0-build Ghostship-3.0.0-dest 2>/dev/null || true && rm -rf Ghostship-3.0.0 Ghostship-3.0.0-build Ghostship-3.0.0-dest && /usr/bin/cmake -E tar xf /home/maxwe/Ghostship/build-web/Ghostship-3.0.0.tar.gz && chmod -R u-w Ghostship-3.0.0 && mkdir Ghostship-3.0.0-build && mkdir Ghostship-3.0.0-dest && /usr/bin/cmake -DCMAKE_INSTALL_PREFIX=Ghostship-3.0.0-dest Ghostship-3.0.0 -B Ghostship-3.0.0-build && make -C Ghostship-3.0.0-build -j4 && make -C Ghostship-3.0.0-build test && make -C Ghostship-3.0.0-build install && make -C Ghostship-3.0.0-build clean && chmod -R u+w Ghostship-3.0.0 Ghostship-3.0.0-build Ghostship-3.0.0-dest && rm -rf Ghostship-3.0.0 Ghostship-3.0.0-build Ghostship-3.0.0-dest && echo Ghostship-3.0.0.tar.gz\ is\ ready\ for\ distribution.

