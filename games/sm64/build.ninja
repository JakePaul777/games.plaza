=1 -DF3D_OLD=1 -DGBI_FLOATS=1 -DUSE_OPENGLES=1 -DVERSION_US=1 -DYAML_CPP_STATIC_DEFINE -D_FILE_OFFSET_BITS=64 -D_LANGUAGE_C -D_USE_MATH_DEFINES
