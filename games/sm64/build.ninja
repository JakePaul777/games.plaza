  INCLUDES = -I/home/maxwe/Ghostship -I/home/maxwe/Ghostship/include -I/home/maxwe/Ghostship/src -I/home/maxwe/Ghostship/build-web -I/home/maxwe/Ghostship/build-web/include -I/home/maxwe/Ghostship/libultraship/include -I/home/maxwe/Ghostship/libultraship/include/libultraship -I/home/maxwe/Ghostship/build-web/_deps/dr_libs-src -I/home/maxwe/Ghostship/build-web/_deps/tinyxml2-src
