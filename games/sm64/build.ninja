build _deps/tinyxml2-build/CMakeFiles/tinyxml2.dir/tinyxml2.cpp.o: CXX_COMPILER__tinyxml2_unscanned_Release /home/maxwe/Ghostship/build-web/_deps/tinyxml2-src/tinyxml2.cpp || cmake_object_order_depends_target_tinyxml2
  CONFIG = Release
